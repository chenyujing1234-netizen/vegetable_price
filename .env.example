# ===== Backend =====
APP_ENV=dev
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-prod

# Database
DATABASE_URL=postgresql+asyncpg://veg:vegpass@localhost:5432/vegdb
SYNC_DATABASE_URL=postgresql+psycopg://veg:vegpass@localhost:5432/vegdb

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000

# ===== Crawlers =====
CRAWL_USER_AGENT=Mozilla/5.0 (compatible; VegBot/0.1; +https://example.com/bot)
CRAWL_REQUEST_TIMEOUT=20
CRAWL_RETRY_TIMES=3

# 海天气象 (https://htqx.cn)
HTQX_API_KEY=

# 极速数据 / 聚合数据天气 API (备用)
JISU_APP_KEY=
JUHE_APP_KEY=

# 高德地图 Web 服务 / JS API
AMAP_WEB_KEY=

# Google Earth Engine (Phase 4 才用)
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=

# ===== Frontend =====
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
